# Accounts API settings. For local dev, copy to .env.server.local (git-ignored).
# Every value has a safe development default, so this file is optional locally.
# In production, set these as environment variables on your host instead of using a file.

# development | production
NODE_ENV=development
PORT=8787

# Local dev: leave unset to use an embedded Postgres (PGlite) in server/.data/.
# Production: a real Postgres URL with TLS, e.g.
# DATABASE_URL=postgres://app_user:<password>@db.example.com:5432/college_hub?sslmode=verify-full
# DATABASE_URL=
DB_POOL_MAX=10

# Vercel only. DATABASE_URL and DATABASE_URL_UNPOOLED come from the connected Neon database.
# Set this for Preview only, and only if previews have their own database branch.
# MIGRATE_PREVIEW_DB=true

# Origins allowed to call the API with cookies (comma-separated, no trailing slash).
APP_ORIGIN=http://localhost:5173
# Production example:
# APP_ORIGIN=https://laxed-college-hub.vercel.app

# Proxy hops in front of the API (1 for Render, Fly, Railway or a load balancer). Needed for real client IPs
# in rate limiting and for detecting HTTPS.
TRUST_PROXY=0
# Redirect HTTP to HTTPS. On by default in production.
# FORCE_HTTPS=true

# Sessions end SESSION_IDLE_HOURS after the last request or SESSION_TTL_HOURS after login.
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24

# scrypt cost. 131072 (2^17) uses about 128 MB of RAM per hash for ~0.2 to 0.5 s.
# Lower it (65536) only if your instance has under 512 MB of RAM.
SCRYPT_N=131072

# Serve HTTPS directly (only if no proxy terminates TLS for you).
# TLS_CERT_FILE=/etc/ssl/college-hub/fullchain.pem
# TLS_KEY_FILE=/etc/ssl/college-hub/privkey.pem

# Create admin@collegehub.test and student@collegehub.test on start. On by default outside production,
# and refused in production.
# SEED_TEST_ACCOUNTS=true

# For `npm run db:create-admin` (create your first real admin in production).
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
